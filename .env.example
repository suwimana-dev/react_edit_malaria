# Copy to .env.local for local work. .env.local is for your machine only: never commit it.
# Leave VITE_API_BASE unset to use the deployed Cloud Run backend (the default, unchanged).
# VITE_API_BASE=http://localhost:8010
# The viewer refuses to talk to a backend whose build_id differs. Override only if your backend reports another id.
# VITE_BUILD_ID=survey-risk-v6
